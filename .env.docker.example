# ============================================================
#   Docker 部署配置
#
#   复制成 .env 后按需修改：
#     Windows  copy .env.docker.example .env
#     Linux    cp .env.docker.example .env
#
#   ⚠️ .env 已被 .gitignore 排除，不会进版本库。
# ============================================================

# ---------- 数据库 ----------
DB_PASSWORD=123456
DB_NAME=love
# 宿主机端口（容器内固定 3306）。本机已有 MySQL 时改成 3307
DB_PORT=3306

# ---------- 后端 ----------
# 宿主机端口，方便直接调接口
BACKEND_PORT=3000

# ---------- 前端 ----------
# 浏览器访问这个端口
WEB_PORT=8080

# ---------- 生产密钥（务必修改！）----------
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 生产环境 JWT_SECRET 必须 >= 32 位，否则启动会被配置校验拦下
JWT_SECRET=please-change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# ---------- 限流 ----------
RATE_LIMIT_MAX=300
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_AUTH_MAX=10

# ---------- CORS ----------
# 容器部署时前后端同源，理论上不用放开。
# 保留 * 便于本地调试；上线公网建议填具体域名。
CORS_ORIGIN=*