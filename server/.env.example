# ---------- 服务 ----------
NODE_ENV=development
PORT=3000

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
# 你的数据库名。注意：你给的建表脚本里写的是 lovechoice，如果脚本已经执行过，
# 请把这里改成 lovechoice；否则保持 love。
DB_NAME=love
DB_CONNECTION_LIMIT=10

# ---------- 鉴权 ----------
# 生产环境必须换成随机长字符串（至少 32 位）
JWT_SECRET=please-change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------- 玩法规则 ----------
# 好感度上下限，超出会被裁剪
AFFECTION_MIN=0
AFFECTION_MAX=100
# 是否强制校验客户端上报的 nodeKey 必须等于存档里的当前节点（防作弊，建议 true）
STRICT_PLAY=true

# ---------- CORS ----------
# 多个来源用逗号分隔，* 表示不限制
CORS_ORIGIN=*

# ---------- 限流 ----------
# 总开关。不写则：生产环境默认 true，开发环境默认 false。
# 生产环境务必保持开启，否则容易被刷接口 / 批量注册。
RATE_LIMIT_ENABLED=true

# 1) 全站兜底：单 IP 每分钟的总请求数（含所有 GET）
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# 2) 写操作：注册 / 登录 / 推进 / 选择 / 互动 / 存档增删改
#    玩家手速快点是正常的，所以留得比全局宽
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WRITE_WINDOW_MS=60000

# 3) 登录注册：窗口最长、次数最少，专防撞库和批量注册测试号
#    注意：这是每 IP 计数，同机房/同出口 IP 的用户会共享额度，
#    如果部署在校园网或云服务器后面，按实际需要调大
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
