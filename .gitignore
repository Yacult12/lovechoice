# ============================================================
#   依赖
#   node_modules 由 package-lock.json 还原，不进版本库
# ============================================================
node_modules/
.pnp/
.pnp.js

# npm / yarn / pnpm 的调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ============================================================
#   环境变量与密钥（最重要的一条）
#   .env 里存着数据库密码和 JWT 密钥，绝不能提交
#   示例模板要提交，所以逐个开白名单
# ============================================================
.env
.env.*
!.env.example
!.env.docker.example
*.pem
*.key
secrets/
config/secrets/

# ============================================================
#   数据库备份与数据文件
#   *.sql 里的剧本（server/sql/）是源码，要提交；
#   但导出的数据备份、dump 文件不要进库
# ============================================================
*.dump
*.sql.gz
backup/
backups/
data/
*.sqlite
*.sqlite3
*.db

# ============================================================
#   日志
# ============================================================
logs/
*.log
npm-debug.log*
pids/
*.pid
*.seed

# ============================================================
#   测试与覆盖率
#   .smoke/ 是测试脚本本身，要提交；
#   但它的临时输出和缓存不要
# ============================================================
.smoke/*-out.txt
.smoke/.cache/
coverage/
.nyc_output/

# ============================================================
#   构建产物与缓存
# ============================================================
dist/
build/
.cache/
.vite/
.temp/
*.tsbuildinfo

# ============================================================
#   编辑器与 IDE
#   .vscode/ 里的 launch.json 常常含本机路径，不提交；
#   但推荐给团队的工作区配置可以提交
# ============================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
#   运行时与系统文件
# ============================================================
*.pid
*.lock
!package-lock.json
npm-debug.log*
.yarn/
.pnpm-store/

# ============================================================
#   部署相关
#   docker-compose 里常写本地端口和密码，用 example 做模板
# ============================================================
docker-compose.override.yml
.docker/
*.tar
*.tar.gz

# ============================================================
#   浏览器自动化产物（本项目的测试会开无头浏览器）
# ============================================================
.smoke/screenshots/
.smoke/*.log
# 测试截图是临时产物，不入库
.smoke/shot-*.png
.smoke/*.png

# ============================================================
#   音乐素材（版权，不入库）
#
#   audio-src/  下载的原曲（含网易云加密的 .ncm），几十 MB
#   samples/    试听切片，生成物
#
#   两者都可以用 .smoke/decrypt-ncm.mjs + make-samples.js
#   从你自己的音乐目录重新生成 —— 不入库，也不该入库。
# ============================================================
.smoke/audio-src/
.smoke/samples/